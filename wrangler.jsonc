// Cloudflare Worker configuration.
//
// The "Deploy to Cloudflare" button reads this file: it provisions the D1 database
// declared below, writes the real database_id into your copy of the repo, and wires
// the repo to Workers Builds so every push to main redeploys automatically
// (build command: `npm run build`, deploy command: `npx wrangler deploy`).
//
// Keep `main`, `assets` and the `DB` binding valid — the app reads all three.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "manyfold-penny",
  "main": "./src/worker/index.ts",
  "compatibility_date": "2026-08-01",
  "observability": {
    "enabled": true
  },
  "upload_source_maps": true,
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // /_matrix/* is the Narra push wake (Synapse pusher, see gateway/sync.ts).
    "run_worker_first": ["/api/*", "/share/*", "/_matrix/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "manyfold-penny-db",
      "database_id": "458a49fc-1dae-4667-b47f-60c3600d6027"
    }
  ],
  // The Narra gateway (src/worker/gateway): one poller, one queue per chat room.
  // Off unless the NARRA_GATEWAY var is "poll"; the cron only keeps the poller alive.
  "durable_objects": {
    "bindings": [
      { "name": "NARRA_POLLER", "class_name": "NarraPoller" },
      { "name": "ROOM_QUEUE", "class_name": "RoomQueue" },
      // Reads Narra in real time through Matrix /sync; off unless NARRA_SYNC is "on".
      { "name": "MATRIX_SYNC", "class_name": "MatrixSync" },
      // narra-agent-kit's chat-native (v2) gateway (src/worker/kit.ts), only for the rooms in
      // NARRA_PIPELINE_ROOMS: one /sync reader and one coordinator per room.
      { "name": "NARRA_SYNC_DO", "class_name": "NarraMatrixSync" },
      { "name": "NARRA_ROOM_DO", "class_name": "NarraRoomCoordinator" }
    ]
  },
  "migrations": [
    { "tag": "v1-narra-gateway", "new_sqlite_classes": ["NarraPoller", "RoomQueue"] },
    { "tag": "v2-matrix-sync", "new_sqlite_classes": ["MatrixSync"] },
    { "tag": "v3-narra-agent-kit", "new_sqlite_classes": ["NarraMatrixSync", "NarraRoomCoordinator"] }
  ],
  // Workers AI: the kit's relevance scoring (one small multilingual embedding per unaddressed message).
  "ai": { "binding": "AI" },
  "triggers": { "crons": ["*/5 * * * *"] },
  "vars": {
    // Manyfold API base. Point at https://api-staging.manyfold.ai via .dev.vars for local dev.
    "MANYFOLD_API_BASE_URL": "https://api.manyfold.ai",
    // "production" enforces https-only and no-private-IP checks on agent URLs.
    "ENVIRONMENT": "production",
    // The Narra gateway (src/worker/gateway): on. It also needs the NARRA_AGENT_TOKEN secret,
    // and the Manyfold Matrix channel switched off, or Penny answers twice.
    "NARRA_GATEWAY": "poll",
    // Real-time reading through Matrix /sync (gateway/sync.ts). "off" falls back to polling alone.
    "NARRA_SYNC": "on",
    // Synapse wakes MatrixSync per event instead of a 24/7 /sync long-poll (billed as Durable
    // Object duration), and the poller sleeps between backstop reads. Synapse only accepts a pusher
    // at exactly /_matrix/push/v1/notify, so this is the workers.dev hostname (served at its root).
    // Needs the NARRA_PUSH_SECRET secret (>= 16 chars); without it MatrixSync keeps long-polling.
    "NARRA_SYNC_MODE": "push",
    "NARRA_PUSH_URL": "https://manyfold-penny.netmind-ai.workers.dev",
    "PENNY_AGENT_ID": "agt_agrbonsbdn5wtdhrvskhurpspu",
    // narra-agent-kit's chat-native pipeline (src/worker/kit.ts) serves ONLY the rooms listed in
    // NARRA_PIPELINE_ROOMS ("zack test"); NARRA_PIPELINE_ONLY_LISTED makes it ignore every other room,
    // and Penny's own gateway skips the listed ones (gateway/handoff.ts). It shares NARRA_SYNC,
    // NARRA_SYNC_MODE, NARRA_PUSH_URL, NARRA_PUSH_SECRET and NARRA_AGENT_TOKEN with Penny's gateway;
    // its pusher has its own app_id and pushkey (routePush in kit.ts). "off" gives the room back.
    "NARRA_GATEWAY_ENABLED": "on",
    "NARRA_PIPELINE": "v2",
    "NARRA_PIPELINE_ROOMS": "!ttLCzSZsdFiPSEPDyO:matrix.netmind.chat",
    "NARRA_PIPELINE_ONLY_LISTED": "on"
  }
  // Optional hardening, neither is required to deploy:
  //   npx wrangler secret put ADMIN_PASSWORD          # locks the app behind a password
  //   npx wrangler secret put CONFIG_ENCRYPTION_KEY   # >=32 chars; otherwise a key is generated and stored in D1
}
