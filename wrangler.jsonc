// Cloudflare Worker configuration.
//
// The "Deploy to Cloudflare" button reads this file: it provisions the D1 database
// declared below, writes the real database_id into your copy of the repo, and wires
// the repo to Workers Builds so every push to main redeploys automatically
// (build command: `npm run build`, deploy command: `npx wrangler deploy`).
//
// Keep `main`, `assets` and the `DB` binding valid — the app reads all three.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "manyfold-penny",
  "main": "./src/worker/index.ts",
  "compatibility_date": "2026-08-01",
  "observability": {
    "enabled": true
  },
  "upload_source_maps": true,
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/share/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "manyfold-penny-db",
      "database_id": "458a49fc-1dae-4667-b47f-60c3600d6027"
    }
  ],
  // The Narra gateway (src/worker/gateway): one poller, one queue per chat room.
  // Off unless the NARRA_GATEWAY var is "poll"; the cron only keeps the poller alive.
  "durable_objects": {
    "bindings": [
      { "name": "NARRA_POLLER", "class_name": "NarraPoller" },
      { "name": "ROOM_QUEUE", "class_name": "RoomQueue" }
    ]
  },
  "migrations": [{ "tag": "v1-narra-gateway", "new_sqlite_classes": ["NarraPoller", "RoomQueue"] }],
  "triggers": { "crons": ["*/5 * * * *"] },
  "vars": {
    // Manyfold API base. Point at https://api-staging.manyfold.ai via .dev.vars for local dev.
    "MANYFOLD_API_BASE_URL": "https://api.manyfold.ai",
    // "production" enforces https-only and no-private-IP checks on agent URLs.
    "ENVIRONMENT": "production",
    // The Narra gateway (src/worker/gateway): on. It also needs the NARRA_AGENT_TOKEN secret,
    // and the Manyfold Matrix channel switched off, or Penny answers twice.
    "NARRA_GATEWAY": "poll",
    "PENNY_AGENT_ID": "agt_agq5agsd2f4plp3442ipkm6isy"
  }
  // Optional hardening, neither is required to deploy:
  //   npx wrangler secret put ADMIN_PASSWORD          # locks the app behind a password
  //   npx wrangler secret put CONFIG_ENCRYPTION_KEY   # >=32 chars; otherwise a key is generated and stored in D1
}
